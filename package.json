{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --import tsx -e \"process.env.NODE_ENV='production'; import('./server.ts')\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:backup": "tsx scripts/db/backup.ts",
    "db:restore": "tsx scripts/db/restore.ts",
    "auth:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "auth:recover-admin": "tsx scripts/recover-admin.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
