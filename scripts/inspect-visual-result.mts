import fs from 'node:fs';import pg from 'pg';const c=JSON.parse(fs.readFileSync('.local-demo/config.json','utf8'));const db=new pg.Client({host:'127.0.0.1',port:c.dbPort,user:'postgres',password:c.password,database:'pemara_demo_utf8'});await db.connect();const row=(await db.query(`SELECT l.id,r.spec_json FROM lessons l JOIN lesson_revisions r ON r.lesson_id=l.id AND r.version=l.current_version WHERE NOT l.is_deleted ORDER BY l.created_at DESC LIMIT 1`)).rows[0];
fs.writeFileSync('docs/evidencias/teste-ia-generico/aula-melhorada.json',JSON.stringify(row.spec_json,null,2));console.log(JSON.stringify({id:row.id,metadata:row.spec_json.lesson,scenes:row.spec_json.scenes.map((s:any)=>({id:s.id,title:s.title,type:s.type,visual:s.visual?.layout,nodes:s.visual?.nodes.map((n:any)=>n.icon)}))},null,2));await db.end();
