# PEMARA EDU — Configurações do Ambiente (.env)

# Rede e Servidor Local (MVP Piloto)
# Para o piloto em desenvolvimento, o HOST padrão é 127.0.0.1 (localhost-first por segurança).
# A publicação na LAN escolar (ex: 0.0.0.0 ou IP privado fixado) deve ocorrer apenas
# após a implementação de autenticação e firewall na etapa E3.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Banco de Dados PostgreSQL (Alvo E2)
# Configuração para conexão local do servidor (não expor externamente)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pemara_edu

# IA inteiramente OPCIONAL. Deixe vazio para operar sem IA e sem chave.
# IDs: openai, gemini, anthropic, deepseek, groq, mistral, openrouter, xai,
# together, fireworks, cerebras, perplexity, sambanova, huggingface, nvidia,
# ollama, lmstudio, compatible.
AI_PROVIDER=""
AI_TIMEOUT_MS=60000
# Para cada provedor: <ID_MAIUSCULO>_MODEL, _API_KEY e opcional _BASE_URL.
# Escolha um modelo disponível na sua conta; não há modelo imposto pelo sistema.
OPENAI_API_KEY=""
OPENAI_MODEL=""
GEMINI_API_KEY=""
GEMINI_MODEL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL=""
GROQ_API_KEY=""
GROQ_MODEL=""
MISTRAL_API_KEY=""
MISTRAL_MODEL=""
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
XAI_API_KEY=""
XAI_MODEL=""
TOGETHER_API_KEY=""
TOGETHER_MODEL=""
FIREWORKS_API_KEY=""
FIREWORKS_MODEL=""
CEREBRAS_API_KEY=""
CEREBRAS_MODEL=""
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL=""
SAMBANOVA_API_KEY=""
SAMBANOVA_MODEL=""
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL=""
NVIDIA_API_KEY=""
NVIDIA_MODEL=""
# IA local: instalar/carregar o modelo no servidor local; chave opcional.
OLLAMA_MODEL=""
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LMSTUDIO_MODEL=""
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Outros servidores, vLLM, llama.cpp, gateways LiteLLM etc.
COMPATIBLE_MODEL=""
COMPATIBLE_BASE_URL=""
COMPATIBLE_API_KEY=""

# URL pública/interna da aplicação (para referências e rotas)
APP_URL="http://localhost:3000"
